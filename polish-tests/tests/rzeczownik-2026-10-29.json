      "title": "Ten, ta czy to?",
      "instruction_ru": "Выбери правильный указатель рода: ten / ta / to.",
      "questions": [
        { "id": "q1", "type": "choice", "prompt": "___ zdjęcie", "options": ["ten", "ta", "to"], "answer": "to",
