        { "id": "q4", "type": "choice", "prompt": "___ ból", "options": ["ten", "ta", "to"], "answer": "ten",
          "explanation_ru": "Род отличается от русского: «боль» женского рода, а ból — мужского: ten ból." }
      ]
    },
    {
